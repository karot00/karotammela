# Google Gemini API key. Leave empty to use the deterministic offline stub stream.
GOOGLE_GENERATIVE_AI_API_KEY=

# Secret used to sign the karot_unlock HMAC cookie. MUST be set in production.
UNLOCK_COOKIE_SECRET=change-me-to-a-long-random-string

# Port for the Go + HTMX server.
GOTH_PORT=8080

# Gemini model id.
AI_MODEL=gemini-3.1-flash-lite

# SQLite database path (relative to the process working dir).
GOTH_DB_PATH=goth.db

# Public base URL, used for canonical/OG metadata.
APP_URL=https://karotammela.fi

# Public origin of the comparison Next.js build (Vercel subdomain). Used by the
# Tech Switcher cross-origin redirect and the /api/ping CORS allow-list.
NEXT_URL=https://next.karotammela.fi

# URL the perf widget pings to measure the "other" stack's TTFB.
NEXT_PING_URL=http://localhost:3000/api/ping

# "development" or "production" (controls cookie Secure flag + draft visibility).
GOTH_ENV=development

# Resend delivery for POST /api/contact. All three required; without them the
# endpoint returns 503 "Contact delivery is not configured."
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=


# Bearer secret guarding POST /api/ai-pulse/refresh (shared with the Next.js
# CRON_SECRET). Without it the endpoint always returns 401.
CRON_SECRET=

# Provider base-URL overrides for the Phase 12.5 refresh pipeline. Empty uses
# the production endpoints. Used by failure drills (12.5g) and tests.
GOTH_HN_BASE_URL=
GOTH_GITHUB_BASE_URL=
GOTH_YAHOO_BASE_URL=

# Gemini API base-URL override for the refresh pipeline (drills/tests). Empty
# uses the production generativelanguage endpoint.
GOTH_GEMINI_BASE_URL=

# `goth backup` snapshot directory + retention (plan §11.3). Production values
# live in deploy/goth.env.example (/var/lib/goth/backups, keep 14).
GOTH_BACKUP_DIR=backups
GOTH_BACKUP_KEEP=14

# --- VIP portal (MeetingPackage application, plan §5/§15) -----------------
# Master runtime flag. Default false: every VIP route 404s and no navigation
# shows a link in either stack. One flag closes the whole feature.
VIP_ENABLED=false

# Argon2id/scrypt encoded access-code hash, generated offline. Never plaintext.
VIP_PASSWORD_HASH=

# Independent random signing secret for the karot_vip cookie (>= 32 bytes).
VIP_COOKIE_SECRET=

# VIP-only Gemini model, separate from AI_MODEL so Sentinel/AI Pulse stay
# untouched.
VIP_AI_MODEL=gemini-3.5-flash-lite

# Optional absolute path to the CV PDF served only behind the VIP cookie.
# Provisioned on the server separately from the release artifact; never
# committed. When unset, the CV download link and route stay hidden.
VIP_CV_PATH=

# Optional VIP-only contact link. Keep this in the deploy environment, never in Git.
VIP_CONTACT_EMAIL=
VIP_CONTACT_PHONE=
