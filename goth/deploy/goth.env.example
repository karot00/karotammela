# /etc/goth/goth.env — production environment for goth.service,
# goth-refresh.service and goth-backup.service (EnvironmentFile).
#
# Install: copy to /etc/goth/goth.env, fill in the secrets, then
#   chown root:goth /etc/goth/goth.env && chmod 0640 /etc/goth/goth.env
#
# The file is owned by root and group-readable by the goth service account
# (0640, NOT world-readable) so both systemd (reads as root) and the deploy
# script / manual `goth migrate` (run as the goth user) can read it.
# NEVER commit a filled-in copy of this file. Secrets live only on the host.
#
# NOTE on names: plan §11.4 refers to legacy names GOTH_ADDR and
# GOTH_DATABASE_PATH. The implemented names (internal/config/config.go) are
# GOTH_PORT and GOTH_DB_PATH — this file is the authoritative contract.

# --- Core runtime -------------------------------------------------------
# "production" enables the Secure cookie flag and hides draft blog posts.
GOTH_ENV=production

# Listen port behind Caddy (systemd units and deploy.sh health check assume 8080).
GOTH_PORT=8080
GOTH_HOST=127.0.0.1

# SQLite database (plan §11.2 layout; owned by the goth user, WAL mode).
GOTH_DB_PATH=/var/lib/goth/goth.db

# Public base URL for canonical/OG metadata.
APP_URL=https://karotammela.fi

# --- Secrets (generate/copy per host; never reuse dev values) ------------
# HMAC key for the karot_unlock cookie. MUST equal the Next.js
# UNLOCK_COOKIE_SECRET so unlock state survives tech switching.
# Generate: openssl rand -hex 32
UNLOCK_COOKIE_SECRET=

# Bearer secret guarding POST /api/ai-pulse/refresh. Shared with the
# Next.js CRON_SECRET. Generate: openssl rand -hex 32
CRON_SECRET=

# Google Gemini API key (SENTINEL-7 streaming + AI Pulse summaries).
GOOGLE_GENERATIVE_AI_API_KEY=

# Gemini model id.
AI_MODEL=gemini-3.1-flash-lite

# --- Contact form (Resend) ----------------------------------------------
# All three required; otherwise POST /api/contact returns 503.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=info@karotammela.fi
CONTACT_TO_EMAIL=info@karotammela.fi

# --- Tech Switcher experiment --------------------------------------------
# Public origin of the comparison Next.js build (hosted natively on Vercel).
# Used by the Tech Switcher (cross-origin redirect) and the /api/ping CORS
# allow-list so the Next.js perf widget may ping Go client-side.
NEXT_URL=https://next.karotammela.fi
# Server-side probe target for the legacy /api/ping?target=next path. The
# comparison Next.js build is hosted NATIVELY on Vercel at the
# next.karotammela.fi subdomain (NOT proxied through this host). Point this at
# that subdomain so the existing server-side probe keeps working until the perf
# widget is migrated to direct client-side fetches (Phase 9). Leave empty to
# disable the cross-stack probe once the experiment ends.
NEXT_PING_URL=https://next.karotammela.fi/api/ping

# --- Backups (goth backup / goth-backup.timer, plan §11.3) ----------------
# Local snapshot directory (inside ReadWritePaths of the systemd units).
GOTH_BACKUP_DIR=/var/lib/goth/backups
# How many timestamped snapshots to keep locally.
GOTH_BACKUP_KEEP=14

# --- Provider overrides (leave empty in production) -----------------------
# Drill/test hooks only; empty means the real endpoints.
#GOTH_HN_BASE_URL=
#GOTH_GITHUB_BASE_URL=
#GOTH_YAHOO_BASE_URL=
#GOTH_GEMINI_BASE_URL=

# --- VIP portal (MeetingPackage application, plan §5/§15) ------------------
# Master runtime flag. Keep false until the invitation window opens; setting
# it false and restarting goth.service closes every VIP route immediately and
# hides the Next.js dashboard link on its next request (runbook §VIP).
VIP_ENABLED=false

# Argon2id/scrypt encoded access-code hash, generated offline on the host.
# NEVER plaintext. Production startup fails when VIP_ENABLED=true without it.
VIP_PASSWORD_HASH=

# Independent random signing secret for the karot_vip cookie (>= 32 bytes),
# separate from UNLOCK_COOKIE_SECRET. Generate: openssl rand -hex 32
VIP_COOKIE_SECRET=
VIP_CONTENT_DIR=/var/lib/goth/private/vip

# VIP-only Gemini model, separate from AI_MODEL so Sentinel/AI Pulse stay
# untouched.
VIP_AI_MODEL=gemini-3.5-flash-lite

# Optional absolute path to the CV PDF served only behind the VIP cookie.
# Provisioned on the server separately from the release artifact and never
# committed to the repository. When unset, the download link and route are
# hidden. Example: /var/lib/goth/private/Karo_Tammela_CV_2026_08_en.pdf
VIP_CV_PATH=
VIP_CONTACT_EMAIL=
VIP_CONTACT_PHONE=
