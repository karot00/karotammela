{
	admin off
}

# Map the `tech` cookie to an upstream. Default to the original Next.js app.
map {http.request.cookie.tech} {upstream} {
	default        next
	next           localhost:3000
	go             localhost:8080
}

:80 {
	header {
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	# Canonical + SEO passthrough to whichever upstream is active.
	reverse_proxy {upstream}
}
